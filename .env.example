# =====================================================
# SmartReco 2.0
# Behavioral AI Recommendation Platform
# =====================================================

# -------------------------
# Application
# -------------------------
APP_NAME=SmartReco
DEBUG=true

# -------------------------
# Security
# -------------------------
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -------------------------
# Mesh API (Required)
# -------------------------
MESH_API_KEY=your_mesh_api_key_here
MODEL_NAME=openai/gpt-4.1-mini

# -------------------------
# Database
# -------------------------
DATABASE_URL=sqlite:///./data/smartreco.db

# -------------------------
# Vector Database
# -------------------------
CHROMA_PERSIST_DIR=./data/chroma

# -------------------------
# Embeddings
# -------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -------------------------
# Logging
# -------------------------
LOG_LEVEL=DEBUG